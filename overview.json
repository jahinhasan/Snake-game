    "requirements.txt": [
      "# Runtime dependencies for LLM-Enhanced Intelligent Snake Arena.",
      "#",
      "# PyTorch: the default PyPI wheel bundles CUDA support and is very large.",
      "# For a CPU-only install (recommended, and sufficient for this project) use:",
      "#",
      "#   pip install torch --index-url https://download.pytorch.org/whl/cpu",
      "#",
      "# then `pip install -r requirements.txt` (torch will already be satisfied).",
      "# GPU acceleration is used automatically if a CUDA build is installed, but is",
      "# never required: everything trains and runs on CPU."
    ],
    "run_linux.sh": [
      "#!/usr/bin/env bash",
      "# Launch LLM-Enhanced Intelligent Snake Arena on Linux.",
      "# Uses .venv when present; falls back to the system python.",
      "set -euo pipefail",
      "cd \"$(dirname \"$0\")\"",
      "",
      "if [ -x .venv/bin/python ]; then",
      "PY=\".venv/bin/python\"",
      "else",
      "PY=\"python3\""
    ],
    "run_windows.bat": [
      "@echo off",
      "rem Launch LLM-Enhanced Intelligent Snake Arena on Windows 10/11.",
      "rem Uses the project virtual environment when present.",
      "setlocal",
      "cd /d \"%~dp0\"",
      "",
      "if exist \".venv\\Scripts\\python.exe\" (",
      "\".venv\\Scripts\\python.exe\" main.py %*",
      ") else (",
      "echo note: no .venv found - using system python. Run setup_windows.ps1 first for an isolated install."
    ],
    "setup_linux.sh": [
      "#!/usr/bin/env bash",
      "# Setup for LLM-Enhanced Intelligent Snake Arena on Linux (tested on Arch Linux).",
      "# Creates a virtual environment and installs CPU-only PyTorch plus dependencies.",
      "set -euo pipefail",
      "cd \"$(dirname \"$0\")\"",
      "",
      "PYTHON=\"${PYTHON:-python3}\"",
      "",
      "if ! command -v \"$PYTHON\" >/dev/null 2>&1; then",
      "echo \"error: $PYTHON not found. Install python (Arch: sudo pacman -S python) or set PYTHON=/path/to/python.\" >&2"
    ],
    "setup_windows.ps1": [
      "# Setup for LLM-Enhanced Intelligent Snake Arena on Windows 10/11.",
      "#",
      "# NOTE (honest disclosure): this script was authored for Windows but the",
      "# project was developed and tested on Arch Linux only - see WINDOWS_SETUP.md",
      "# and README.md. If a step fails, run the commands manually and report the",
      "# exact error. Requires Python 3.10+ from https://www.python.org/downloads/",
      "# (check \"Add python.exe to PATH\" during install).",
      "",
      "$ErrorActionPreference = \"Stop\"",
      "Set-Location -LiteralPath $PSScriptRoot"
    ]
