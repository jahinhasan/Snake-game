# LLM-Enhanced Intelligent Snake Arena - optional environment overrides.
# Copy to `.env` (never commit .env) or export these in your shell.
# All values are optional; the app works without this file.

# Override the runtime data directory (default: <project>/data)
SNAKE_ARENA_DATA_DIR=

# Override the model checkpoints directory (default: <project>/models)
SNAKE_ARENA_MODELS_DIR=

# Ollama HTTP endpoint
SNAKE_ARENA_OLLAMA_HOST=http://127.0.0.1:11434

# Default Ollama model tag (download with: ollama pull qwen3:4b)
SNAKE_ARENA_OLLAMA_MODEL=qwen3:4b

# Set to 1 to disable all LLM features (pure classical-AI mode)
SNAKE_ARENA_DISABLE_LLM=0

# Logging level: DEBUG, INFO, WARNING, ERROR
SNAKE_ARENA_LOG_LEVEL=INFO
